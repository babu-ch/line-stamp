# Copy this to .env and fill in at least one key.
# Gemini (nano-banana provider, default): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# OpenAI (gpt-image-* family): https://platform.openai.com/api-keys
OPENAI_API_KEY=

# OpenAI のデフォルトモデル (--model で都度上書き可)
# OpenAI は新世代 / フロンティアモデルに organization verification (KYC) を要求するポリシーで、
# 現時点では gpt-image-2 が該当 (今後 gpt-image-3 等が出ても同じ運用になる可能性が高い)。
# verify 手順: https://platform.openai.com/settings/organization/general → "Verify Organization"
# Persona 経由で ID + 顔認証 (5〜15 分)、1 org 1 回で全 verify 必須モデル解禁。
# verify 不要モデル (gpt-image-1 / gpt-image-1.5 など旧世代) はそのまま使える。
# デフォを gpt-image-1 にしてあるのは verify せず即動かせるようにするため。
OPENAI_MODEL=gpt-image-1
